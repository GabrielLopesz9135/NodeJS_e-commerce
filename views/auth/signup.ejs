<%- include('../includes/head.ejs') %>
    <link rel="stylesheet" href="/css/forms.css">
    <link rel="stylesheet" href="/css/auth.css">
</head>

<body>
   <%- include('../includes/navigation.ejs') %>

    <main>
        <form class="login-form" action="/signup" method="POST" novalidate>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="form-control">
                <label for="email">E-Mail</label>
                <input
                    class="<%= errors.find(err => err.path === 'email') ? 'invalid' : '' %>"
                    type="email" 
                    name="email" 
                    id="email" 
                    value="<%= typeof oldInput !== 'undefined' ? (oldInput?.email ?? '') : '' %>">
            </div>
            <div class="form-control">
                <label for="password">Password</label>
                <input 
                    class="<%= errors.find(err => err.path === 'password') ? 'invalid' : '' %>"
                    type="password" 
                    name="password" 
                    id="password" 
                    value="<%= typeof oldInput !== 'undefined' ? (oldInput?.password ?? '') : '' %>">
            </div>
            <div class="form-control">
                <label for="confirmPassword">Confirm Password</label>
                <input 
                    class="<%= errors.find(err => err.path === 'confirmPassword') ? 'invalid' : '' %>"
                    type="password" 
                    name="confirmPassword" 
                    id="confirmPassword" 
                    value="<%= typeof oldInput !== 'undefined' ? (oldInput?.confirmPassword ?? '') : '' %>">
            </div>
            <button class="btn" type="submit">Sign Up</button>
        </form>
    </main>
    <% for (let error of errors) { %>
        <div class="user-message user-message-error"><%= error.msg %></div>
    <% } %>
<%- include('../includes/end.ejs') %>